{
  "name": "Item",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Item title"
    },
    "description": {
      "type": "string",
      "description": "Editorial description"
    },
    "category": {
      "type": "string",
      "enum": [
        "fine_art",
        "decorative_art",
        "jewelry",
        "asian_antiques",
        "fashion_accessories",
        "watches_clocks",
        "furniture",
        "collectibles",
        "other"
      ]
    },
    "subcategory": {
      "type": "string"
    },
    "style": {
      "type": "string"
    },
    "technique": {
      "type": "string"
    },
    "keywords": {
      "type": "string"
    },
    "condition": {
      "type": "string",
      "enum": [
        "excellent",
        "very_good",
        "good",
        "fair",
        "as_is"
      ]
    },
    "provenance": {
      "type": "string"
    },
    "provenance_docs": {
      "type": "array",
      "description": "Uploaded provenance documents (JPG or PDF)",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    },
    "condition_notes": {
      "type": "string"
    },
    "internal_notes": {
      "type": "string"
    },
    "images": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "seller_email": {
      "type": "string"
    },
    "seller_name": {
      "type": "string"
    },
    "location": {
      "type": "string",
      "description": "Internal storage location (not shown to buyers)"
    },
    "customer_location": {
      "type": "string",
      "description": "Public-facing location shown to buyers (e.g. New York, NY)"
    },
    "inventory_number": {
      "type": "string",
      "description": "Custom inventory / lot reference number assigned by the seller"
    },
    "ownership_type": {
      "type": "string",
      "enum": [
        "owned",
        "consignment"
      ],
      "default": "owned",
      "description": "Whether the seller owns the item outright or is selling on consignment"
    },
    "consignor_name": {
      "type": "string"
    },
    "consignor_email": {
      "type": "string"
    },
    "consignor_phone": {
      "type": "string"
    },
    "consignor_address": {
      "type": "string"
    },
    "consignor_commission_percent": {
      "type": "number"
    },
    "consignor_payout_amount": {
      "type": "number"
    },
    "consignor_notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "scheduled",
        "first_bids",
        "buy_now",
        "prisometer",
        "sold",
        "pending_review",
        "unsold",
        "declined"
      ],
      "default": "draft",
      "description": "Phase 1 = first_bids (preview, stagnant gray), Phase 2 = buy_now (stagnant + Buy Now), Phase 3 = prisometer (declining)"
    },
    "lot_number": {
      "type": "string"
    },
    "first_bids_duration_hours": {
      "type": "number",
      "description": "Phase 1 (Preview) duration"
    },
    "first_bids_start": {
      "type": "string",
      "format": "date-time"
    },
    "first_bids_end": {
      "type": "string",
      "format": "date-time"
    },
    "anti_snipe_window_minutes": {
      "type": "number",
      "default": 10,
      "description": "Phase 1 anti-snipe extension window applied when a qualifying bid (>= Pri$ometer displayed price) lands near expiry"
    },
    "phase_2_duration_hours": {
      "type": "number",
      "default": 72,
      "description": "Phase 2 (Stagnant + Buy Now) duration"
    },
    "phase_2_start": {
      "type": "string",
      "format": "date-time"
    },
    "phase_2_end": {
      "type": "string",
      "format": "date-time"
    },
    "prisometer_start_price": {
      "type": "number",
      "description": "The Pri$ometer displayed price \u2014 stagnant in Phase 1 & 2, declines in Phase 3. Must be at or above the hidden reserve."
    },
    "reserve_price": {
      "type": "number",
      "description": "Hidden minimum reserve price (never shown to buyers)"
    },
    "below_reserve_percent": {
      "type": "number",
      "enum": [
        10,
        15,
        20
      ]
    },
    "prisometer_duration_hours": {
      "type": "number",
      "description": "Phase 3 (Declining) duration \u2014 controls the decline rate"
    },
    "phase_1_color": {
      "type": "string",
      "enum": [
        "gray",
        "red",
        "amber",
        "green"
      ],
      "default": "gray",
      "description": "Pri$ometer illumination color during Phase 1"
    },
    "phase_2_color": {
      "type": "string",
      "enum": [
        "gray",
        "red",
        "amber",
        "green"
      ],
      "default": "red",
      "description": "Pri$ometer illumination color during Phase 2"
    },
    "phase_3_color": {
      "type": "string",
      "enum": [
        "gray",
        "red",
        "amber",
        "green"
      ],
      "default": "green",
      "description": "Pri$ometer illumination color during Phase 3"
    },
    "prisometer_activated_at": {
      "type": "string",
      "format": "date-time",
      "description": "When Phase 3 (declining) began"
    },
    "current_price": {
      "type": "number"
    },
    "highest_bid": {
      "type": "number",
      "default": 0
    },
    "highest_bidder_email": {
      "type": "string"
    },
    "bid_count": {
      "type": "number",
      "default": 0
    },
    "watcher_count": {
      "type": "number",
      "default": 0
    },
    "view_count": {
      "type": "number",
      "default": 0
    },
    "sold_price": {
      "type": "number"
    },
    "sold_to_email": {
      "type": "string"
    },
    "sold_via": {
      "type": "string",
      "enum": [
        "bid",
        "make_it_mine",
        "seller_accepted"
      ]
    },
    "make_it_mine_active": {
      "type": "boolean",
      "default": false
    },
    "make_it_mine_buyer": {
      "type": "string"
    },
    "make_it_mine_expires": {
      "type": "string",
      "format": "date-time"
    },
    "estimated_low": {
      "type": "number"
    },
    "estimated_high": {
      "type": "number"
    },
    "dimensions": {
      "type": "string"
    },
    "materials": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "origin": {
      "type": "string"
    },
    "maker": {
      "type": "string"
    },
    "marks": {
      "type": "string"
    },
    "short_description": {
      "type": "string"
    },
    "shipping_notes": {
      "type": "string"
    }
  },
  "required": [
    "title",
    "category",
    "prisometer_start_price"
  ]
}